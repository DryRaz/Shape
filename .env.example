# Supabase project credentials (Project Settings > API)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Used only by scripts/import-wger-exercises.ts (server-side import script, not shipped to the browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Set as a secret on the Supabase Edge Function `analyze-meal-photo`, not in this file:
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...

# Web Push (generate with: npx web-push generate-vapid-keys)
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key

# Set as secrets on the Supabase Edge Function `send-reminder-notifications`, not in this file:
#   supabase secrets set VAPID_PUBLIC_KEY=... VAPID_PRIVATE_KEY=... VAPID_SUBJECT=mailto:you@example.com
